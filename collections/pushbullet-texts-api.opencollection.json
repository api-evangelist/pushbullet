{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pushbullet HTTP Channels Texts API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Access-Token",
      "value": "{{Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Texts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send SMS/MMS",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pushbullet.com/v2/texts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send SMS/MMS"
        }
      ]
    }
  ],
  "bundled": true
}