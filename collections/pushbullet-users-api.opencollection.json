{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pushbullet HTTP Channels Users API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Access-Token",
      "value": "{{Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pushbullet.com/v2/users/me"
          },
          "docs": "Get the current user"
        }
      ]
    }
  ],
  "bundled": true
}